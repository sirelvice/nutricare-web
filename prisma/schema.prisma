generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String           @id @default(cuid())
  email            String           @unique
  name             String?
  passwordHash     String
  role             Role             @default(USER)
  stripeCustomerId String?
  subscriptionTier SubscriptionTier @default(FREE)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  profile        Profile?
  weightEntries  WeightEntry[]
  nutritionPlans NutritionPlan[]
}

model Profile {
  id        String        @id @default(cuid())
  userId    String        @unique
  heightCm  Float?
  age       Int?
  gender    Gender
  activity  ActivityLevel
  goal      Goal
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WeightEntry {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  weightKg  Float
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model NutritionPlan {
  id             String   @id @default(cuid())
  userId         String
  version        Int
  goal           Goal
  targetCalories Int
  proteinG       Int
  carbsG         Int
  fatG           Int
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, version])
  @@index([userId, createdAt])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum Goal {
  LOSE
  MAINTAIN
  GAIN
}

enum Role {
  USER
  CLINICIAN
  ADMIN
}

enum SubscriptionTier {
  FREE
  PRO
  CLINIC
}
