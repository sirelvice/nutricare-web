generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String           @id @default(cuid())
  email            String           @unique
  name             String?
  passwordHash     String
  role             Role             @default(USER)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  profile             Profile?
  weightEntries       WeightEntry[]
  nutritionPlans      NutritionPlan[]
  progressEvaluations ProgressEvaluation[]
}

model Profile {
  id        String        @id @default(cuid())
  userId    String        @unique
  heightCm  Float?
  age       Int?
  gender    Gender
  activity  ActivityLevel
  goal      Goal
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WeightEntry {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  weightKg  Float
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model NutritionPlan {
  id                  String               @id @default(cuid())
  userId              String
  version             Int
  goal                Goal
  targetCalories      Int
  proteinG            Int
  carbsG              Int
  fatG                Int
  createdAt           DateTime             @default(now())
  progressEvaluations ProgressEvaluation[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, version])
  @@index([userId, createdAt])
}

model ProgressEvaluation {
  id                   String               @id @default(cuid())
  userId               String
  planVersionId        String
  state                ProgressState
  changeKg             Float?
  entriesCount         Int
  evaluationDays       Int?
  recommendedAction    RecommendedAction
  recommendationReason RecommendationReason
  adjustmentDecision   AdjustmentDecision   @default(PENDING)
  respondedAt          DateTime?
  evaluatedAt          DateTime             @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  nutritionPlan NutritionPlan @relation(fields: [planVersionId], references: [id], onDelete: Cascade)

  @@index([userId, evaluatedAt])
  @@index([planVersionId, evaluatedAt])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum Goal {
  LOSE
  MAINTAIN
  GAIN
}

enum ProgressState {
  ON_TRACK
  BEHIND_OPPOSITE
  PLATEAU
  INSUFFICIENT_DATA
}

enum RecommendedAction {
  CONTINUE
  REVIEW_ADHERENCE
  CONSIDER_ADJUSTMENT
  SUGGEST_PROFESSIONAL_CONSULT
}

enum RecommendationReason {
  INSUFFICIENT_DATA
  ON_TRACK
  FIRST_PROBLEM
  CONSECUTIVE_PROBLEM
  RECURRENCE_AFTER_ADJUSTMENT
}

enum AdjustmentDecision {
  PENDING
  ACCEPTED
  DECLINED
}

enum Role {
  USER
  CLINICIAN
  ADMIN
}
