generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // url is intentionally removed — handled by adapter in prisma.config.ts
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  passwordHash String   // ← hashed password only (never plain text)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}